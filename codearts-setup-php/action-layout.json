{
  "inputs": {
    "step-name": {
      "type": "input",
      "label": "步骤显示名称",
      "validation": {
        "requiredMessage": "请输入步骤名称"
      }
    },
    "php-version": {
      "type": "singleSelect",
      "label": "PHP 版本",
      "options": [
        { "label": "php-7.2", "value": "7.2" },
        { "label": "php-7.3", "value": "7.3" },
        { "label": "php-7.4", "value": "7.4" },
        { "label": "php-8.0", "value": "8.0" },
        { "label": "php-8.1", "value": "8.1" },
        { "label": "php-8.2", "value": "8.2" },
        { "label": "php-8.3", "value": "8.3" }
      ],
      "validation": {
        "requiredMessage": "请选择 PHP 版本"
      }
    },
    "commands": {
      "type": "shell",
      "label": "构建命令（可选）"
    },
    "continue-on-error": {
      "type": "switch",
      "label": "失败后是否继续运行"
    }
  }
}
